<div class="thrall-deck-wrapper">
    <header>
        <div class="header-info">
            <h2>{{actorName}}</h2>
            <span class="subtext">Lvl {{actorLevel}} | Thrall DMG: {{thrallDamage}}</span>
        </div>
        
        <div class="map-tracker">
            <span>MAP:</span>
            <button type="button" class="map-pip {{map0Active}}" data-value="0">0</button>
            <button type="button" class="map-pip {{map5Active}}" data-value="-5">-5</button>
            <button type="button" class="map-pip {{map10Active}}" data-value="-10">-10</button>
        </div>
    </header>

  <div class="roster-controls">
        <button type="button" class="edit-portfolio-btn" title="Edit Thrall Portfolio">
            <i class="fas fa-book-dead"></i> Edit Thrall Portfolio
        </button>
        {{#if hasHallowedEarth}}
        <button type="button" class="hallowed-btn" title="Toggle Hallowed Earth">
            <i class="fas fa-sun"></i> {{#if isHallowedActive}}Dismiss Hallowed Earth{{else}}Hallowed Earth{{/if}}
        </button>
        {{/if}}
        {{#if hasCorruptedGround}}
        <button type="button" class="corrupted-btn" title="Toggle Corrupted Ground">
            <i class="fas fa-moon"></i> {{#if isCorruptedActive}}Dismiss Corrupted Ground{{else}}Corrupted Ground{{/if}}
        </button>
        {{/if}}
        
        {{#if hasCollateralReinforcement}}
        <button type="button" class="collateral-btn" title="Reinforce Thralls">
            <i class="fas fa-shield-alt"></i> Collateral Reinforcement
        </button>
        {{/if}}
        {{#if hasReclaimPower}}
        <button type="button" class="reclaim-btn" title="Reclaim Power">
            <i class="fas fa-heart-crack"></i> Reclaim Power
        </button>
        {{/if}}
    </div>
{{#if activeHordeCount}}
    <div class="horde-controls" style="display: flex; gap: 5px; margin-top: 10px;">
        <button type="button" class="sustain-horde-btn" title="Move Horde">
            <i class="fas fa-arrows-alt"></i> Sustain (Move)
        </button>
        <button type="button" class="dismiss-horde-btn" title="Dismiss Horde">
            <i class="fas fa-ban"></i> Dismiss Horde
        </button>
    </div>
    {{/if}}
    <!-- Scrollable Roster -->
    <section class="active-thralls-list">
        {{#if activeThralls.length}}
            {{#each activeThralls}}
                <div class="thrall-row" data-token-id="{{this.id}}">
                    <img src="{{this.img}}" alt="{{this.name}}" class="thrall-portrait">
                    
                    <div class="thrall-info">
                        <div class="thrall-header-row">
                            <span class="thrall-name">{{this.name}}</span>
                            
                            <!-- Tactical Proximity Tracker -->
                            <div class="proximity-tracker">
                                <span class="prox-badge enemy" title="Enemies within 10ft">
                                    <i class="fas fa-biohazard"></i> {{this.nearbyEnemies}}
                                </span>
                                <span class="prox-badge friendly" title="Allies within 10ft">
                                    <i class="fas fa-shield-alt"></i> {{this.nearbyFriendlies}}
                                </span>
                            </div>
                        </div>

                        <!-- Action Dropdown -->
                        <div class="form-group">
                            <select class="action-dropdown" name="action">
    <option value="strike">Strike</option>
    <option value="charge">Charge</option>
    {{#if ../hasNecroticBomb}}
        <option value="explode">Necrotic Bomb</option>
    {{/if}}
    {{#if ../hasZombieHorde}}
        <option value="zombie-horde">Zombie Horde</option>
    {{/if}}
    {{#if ../hasDeathlyScream}}
        <option value="deathly-scream">Deathly Scream</option>
    {{/if}}
    {{#if ../hasLifeTap}}
        <option value="life-tap">Life Tap</option>
    {{/if}}
    {{#if ../hasMuscleBarrier}}
        <option value="muscle-barrier">Muscle Barrier</option>
    {{/if}}
    {{#if ../hasSongOfTheSoul}}
        <option value="song-of-the-soul">Song of the Soul</option>
    {{/if}}
    {{#if ../hasBonyBarrage}}
        <option value="bony-barrage">Bony Barrage</option>
    {{/if}}
    {{#if ../hasBoneBurst}}
        <option value="bone-burst">Bone Burst</option>
    {{/if}}
    {{#if ../hasDeadWeight}}
        <option value="dead-weight">Dead Weight</option>
    {{/if}}
    {{#if ../hasPuppeteer}}
        <option value="consume-thrall" {{#if ../consumeDisabled}}disabled{{/if}}>{{../consumeText}}</option>
    {{/if}}
    {{#if ../hasBoneSpear}}
        <option value="bone-spear">Bone Spear</option>
    {{/if}}
    {{#if ../hasBloodInfusion}}
        <option value="blood-infusion">Blood Infusion</option>
    {{/if}}
</select>
                        </div>

                        <!-- Wide Action Buttons Row -->
                        <div class="thrall-actions-row">
                            <button type="button" class="action-btn execute-btn wide-btn" title="Execute Action">
                                <i class="fas fa-swords"></i> Execute
                            </button>
                            <button type="button" class="action-btn kill-btn wide-btn" title="Dismiss Thrall">
                                <i class="fas fa-skull"></i> Dismiss
                            </button>
                        </div>
                    </div>
                </div>
            {{/each}}
        {{else}}
            <p class="empty-state">No thralls active on this battlefield.</p>
        {{/if}}
    </section>

    <footer>
        <button type="button" class="spawn-btn" data-count="1">
            <i class="fas fa-ghost"></i> Spawn 1
        </button>
        <button type="button" class="spawn-btn" data-count="2">
            <i class="fas fa-skulls"></i> Spawn 2
        </button>
        {{#if hasBloodyTendrils}}
        <button type="button" class="conjure-tendrils-btn" data-count="{{tendrilCount}}">
            <i class="fas fa-biohazard"></i> Bloody Tendrils ({{tendrilCount}})
        </button>
        {{/if}}
    </footer>
</div>